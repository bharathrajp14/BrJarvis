# ════════════════════════════════════════════════════════════════════════════════
#  BR JARVIS v41.0 (MARK XLI) — CANONICAL ENVIRONMENT CONFIGURATION TEMPLATE
#  Autonomous AI Operating System with Gateway Routing, Voice, UI, Tools & Security
# ════════════════════════════════════════════════════════════════════════════════

# ── 1. PRIMARY LLM PROVIDERS — THREE-TIER GATEWAY ────────────────────────────
#
# TIER 1 (PRIMARY) — OmniRouter Local Gateway Proxy at http://127.0.0.1:20128/v1
# Serves verified models (antigravity/gemini-3.7-flash-high, kr/claude-sonnet-4.5, auto/*)
JARVIS_ROUTE_GEMINI_TO_GATEWAY=true
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_API_KEY=your_omnirouter_or_proxy_api_key_here
OPENAI_MODEL=antigravity/gemini-3.7-flash-high
BRJARVIS_PROXY_BASE_URL=http://127.0.0.1:20128/v1
BRJARVIS_PROXY_API_KEY=your_omnirouter_or_proxy_api_key_here

# TIER 2 (SECONDARY) — OpenRouter Free Models
# Activated when Tier 1 proxy is on cooldown. Free tier from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# TIER 3 (FALLBACK) — OmniRouter Auto-Routing Pool (http://127.0.0.1:20128/v1)
OMNIROUTER_API_KEY=your_omnirouter_api_key_here
OMNIROUTER_BASE_URL=http://127.0.0.1:20128/v1

# ── 2. MODEL SELECTION & DEFAULT COGNITIVE BACKEND ─────────────────────────────
JARVIS_MODEL_CLAUDE=kr/claude-sonnet-4.5
JARVIS_MODEL_GPT=antigravity/gemini-3.7-flash-high
JARVIS_MODEL_GEMINI=antigravity/gemini-3.7-flash-high
JARVIS_MODEL_OLLAMA=llama3.3
JARVIS_MODEL_VOICE=antigravity/gemini-3.7-flash-high
JARVIS_DEFAULT_BACKEND=gpt

# Google Gemini Direct (for Voice Realtime / fallback only)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_LISTEN_API_KEY=your_google_gemini_api_key_here

# Manus API v2 agent backend (obtain from https://manus.im)
# Keep this only in your local .env; never commit the real key.
MANUS_API_KEY=your_manus_api_key_here
MANUS_API_BASE_URL=https://api.manus.ai
MANUS_AGENT_PROFILE=manus-1.6-lite
MANUS_TIMEOUT_SECONDS=180
MANUS_POLL_INTERVAL_SECONDS=1.0

# ── 3. 100% OFFLINE LLM (Ollama Engine) ────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.3
JARVIS_FORCE_OFFLINE=false

# ── 4. SERVER SECURITY & AUTHENTICATION ─────────────────────────────────────────
# Server API Key required for Web Dashboard, REST endpoints & WebSocket control stream.
# Generate a unique key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_SERVER_API_KEY=replace_with_a_unique_random_key_of_at_least_24_characters
JARVIS_COOKIE_SECURE=false
# New control-plane UI is served at /, /web, /web/rebuild, and /web/control-plane.
# Set false only to roll back the default start page to the legacy static client.
JARVIS_REBUILT_UI_DEFAULT=true
JARVIS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# ── 5. WEB SERVER & NETWORK PORTS ──────────────────────────────────────────────
BR_SERVER_HOST=127.0.0.1
BR_SERVER_PORT=8000
PORT=8000
SCREEN_SHARE_HOST=127.0.0.1
SCREEN_SHARE_PORT=8765

# ── 6. VOICE, AUDIO & SPEECH RECOGNITION ───────────────────────────────────────
JARVIS_ASSISTANT_NAME="BR Jarvis"
JARVIS_WAKE_WORD="hey jarvis"
JARVIS_VOICE_LANGUAGE=en
JARVIS_WHISPER_MODEL=base.en
JARVIS_OFFLINE_STT=false
JARVIS_OFFLINE_TTS=false
JARVIS_ENABLE_SOUND_EFFECTS=false
JARVIS_ENABLE_BARGE_IN=true
JARVIS_AUDIO_MIN_RMS=0.015
JARVIS_MIC_RECOVERY=true
JARVIS_MIC_STALE_SECONDS=5
JARVIS_AUDIO_INPUT_DEVICE=
JARVIS_AUDIO_OUTPUT_DEVICE=

# ── 7. PERMISSION POLICY & SAFETY ENGINE ───────────────────────────────────────
# Options: allow_all | confirm_destructive (recommended) | confirm_all | deny_all
JARVIS_PERMISSION_MODE=confirm_destructive
JARVIS_HEADLESS=false
# Host subprocesses are not an OS isolation boundary; keep disabled in production.
JARVIS_ENABLE_UNSAFE_HOST_EXECUTION=false
# Community plugins execute in-process until a worker isolation backend is configured.
JARVIS_ENABLE_UNTRUSTED_PLUGINS=false

# ── 8. ARTIFACTS, WORKSPACE & RAG MEMORY STORAGE ───────────────────────────────
# Safe host-side export directory for user documents (PDF, DOCX, XLSX, charts)
# Default: %USERPROFILE%\Documents\BR-JARVIS\artifacts\
JARVIS_ARTIFACTS_DIR=
JARVIS_WORKSPACE=./workspace
JARVIS_MEMORY_DB=./memory_db
JARVIS_AUDIT_LOG=./audit.log
JARVIS_SCOPE_FILE=./current_scope.json

# ── 9. SUB-AGENTS, SKILL ENGINE & MCP CONFIGURATION ────────────────────────────
JARVIS_MAX_SUBAGENTS=5
JARVIS_MAX_AGENT_DEPTH=5
JARVIS_SKILLS_DIRS=
MCP_CONFIG_PATH=./config/mcp_servers.json

# ── 10. APP CONNECTORS & EXTERNAL INTEGRATIONS ─────────────────────────────────
# 🐙 GitHub (Personal Access Token with repo/workflow scopes from https://github.com/settings/tokens)
# GITHUB_TOKEN=ghp_your_github_token_here

# ✈️ Telegram Remote Bot (Bot token from @BotFather, numeric ID from @userinfobot)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_ALLOWED_USERS=your_numeric_telegram_user_id

# 📧 Gmail & Google Workspace (App Password from https://myaccount.google.com/apppasswords)
# GMAIL_ADDRESS=youremail@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# 🔎 Tavily Real-Time Web Search (Free tier at https://tavily.com/)
# TAVILY_API_KEY=tvly-your_tavily_key_here

# 📝 Notion Workspace (Internal Integration Secret from https://www.notion.so/my-integrations)
# NOTION_TOKEN=secret_your_notion_token_here

# 💬 Slack Workspace (Bot Token from https://api.slack.com/apps)
# SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_here

# 📺 YouTube Data API v3 (API Key from https://console.cloud.google.com/)
# YOUTUBE_API_KEY=AIzaSyYourYouTubeKeyHere

# ── 11. CAREER OS & APPLICATION CRM CONFIGURATION ──────────────────────────
# Authoritative Excel Projection & Backup Directories
JARVIS_CAREER_TRACKER_PATH=BR_JARVIS_Career_Tracker.xlsx
JARVIS_CAREER_PROFILE_DIR=.jarvis/career/
JARVIS_CAREER_EXCEL_BACKUP_DIR=.jarvis/backups/
JARVIS_CAREER_EMAIL_SYNC_HOURS=24
JARVIS_CAREER_MATCH_THRESHOLD=0.70
JARVIS_CAREER_AUTO_CONFIRM_OFFER=false

# ── 12. CONFIGURABLE AI BACKENDS & GATEWAY ROUTING ────────────────────────────
# Opt in AgentRouter.run(..., routing_policy=...) to the YAML gateway.
JARVIS_AI_GATEWAY_ENABLED=false
# Optional custom path; defaults to config/ai_gateway.yaml.
BRJARVIS_AI_GATEWAY_CONFIG=config/ai_gateway.yaml
# Default policy name for integrations that select a route from the environment.
JARVIS_AI_GATEWAY_POLICY=default
# Provider cooldown after a failed gateway attempt.
BRJARVIS_GATEWAY_COOLDOWN_SECONDS=15

# Provider credentials are referenced by config/ai_gateway.yaml and must remain secret.
# BRJARVIS_PROXY_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# MISTRAL_API_KEY=
